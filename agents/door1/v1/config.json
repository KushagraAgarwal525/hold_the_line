{
  "agent_config": {
    "agent_name": "Meridian night desk door 1",
    "agent_welcome_message": "This is an AI agent in a public security experiment. This call is recorded. Anonymized transcripts may be published. Do not share real personal information.",
    "tasks": [
      {
        "task_type": "conversation",
        "toolchain": {
          "execution": "sequential",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "tools_config": {
          "llm_agent": {
            "agent_type": "simple_llm_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "openai",
              "model": "gpt-4.1-mini",
              "max_tokens": 150,
              "temperature": 0.2
            }
          },
          "synthesizer": {
            "provider": "elevenlabs",
            "provider_config": {
              "voice": "Angelica",
              "voice_id": "IkSv4tkouLJ6kYsQA7XD",
              "model": "eleven_turbo_v2_5"
            },
            "stream": true,
            "buffer_size": 250,
            "audio_format": "wav"
          },
          "transcriber": {
            "provider": "deepgram",
            "model": "nova-3",
            "language": "en",
            "stream": true,
            "encoding": "linear16",
            "sampling_rate": 16000,
            "endpointing": 250
          },
          "input": {
            "provider": "plivo",
            "format": "wav"
          },
          "output": {
            "provider": "plivo",
            "format": "wav"
          }
        },
        "task_config": {
          "call_terminate": 180,
          "hangup_after_silence": 10
        }
      }
    ]
  },
  "agent_prompts": {
    "task_1": {
      "system_prompt": "REPLACE WITH prompt.md BEFORE CREATE. This draft is not a deployable agent."
    }
  }
}
